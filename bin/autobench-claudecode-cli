#!/usr/bin/env python3
"""autobench-claudecode-cli -- benchmark a Claude Code SKILL across MODELS, measured on the wire.

One command surface over the pieces this repository already had: the harness drives one
`claude -p` repetition per cell, Cortex measures it on the wire, and this tool plans the runs
and compiles the three numbers a consumer actually asks for.

    doctor       is the rig able to measure anything at all?
    tasks        what can be benchmarked
    models       model aliases and the rate card behind the cost column
    screen       the OFF-arm gate: is the task measuring the skill, or the model?
    run          one cell (task x arm x model) x reps
    compare      the same work across several models, then report
    report       token efficiency, cost efficiency, latency -- no invocations

THREE MEASURES, and they are not interchangeable:

  token efficiency   tokens per LLM CALL (a model near-constant, +-5% across five
                     structurally different cells) x LLM calls per task (a property of the
                     WORK, swinging 0.4-2.0x for the same model). Reported separately,
                     because the product hides which term moved.
  cost efficiency    tokens priced per tier by pricing.py, then divided by PASS RATE. A model
                     that fails is charged for its failures -- rank on raw tokens and you can
                     pick exactly the wrong model (haiku has the lowest token count on
                     xlsx-fin-font-clean and the worst cost per solved task).
  latency            `cli_duration_api_ms` from the CLI's own result event -- the model's
                     time, excluding local tool execution. Wall time is printed beside it and
                     is a DIAGNOSTIC: it moved x1.34-1.81 for two models doing provably
                     identical work, purely from machine load.

WHAT THIS TOOL WILL NOT DO. It will not tell you a cell is faster or cheaper on a point
estimate. Per-repetition spread runs CV 0.05-0.42, so a median gap is not a finding; pass
`--significance` and read the p FLOOR beside the p. And it will not write into the published
grid: its default output directory sits outside profile.RUN_DIRS, so no later `--freeze` can
sweep a consumer's repetitions into a cell someone has published a number for.
"""
import argparse
import fcntl
import glob
import hashlib
import json
import math
import os
import pathlib
import re
import shlex
import shutil
import socket
import statistics
import subprocess
import sys
import urllib.request
from collections import defaultdict

# resolve() so a symlink on PATH still finds the clone this script belongs to.
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "tools"))

import harness                      # noqa: E402
import pricing                      # noqa: E402
# NOTE this shadows the stdlib `profile` module inside THIS process. That is why the repo is
# not pip-installable as a distribution -- see the installation section of
# docs/DEVELOPER_GUIDE.md.
import profile as prof              # noqa: E402
import cost_significance as cs      # noqa: E402
import stability_probe as sp        # noqa: E402  (imported for COLD_MULT and cw_share only:
#                                   one definition of "cold", the one the study used)

# Deliberately NOT out/runs. profile.RUN_DIRS is the fixed tuple ("out/runs",
# "out/runs-archive"), and `profile.py --freeze` pins whatever it finds there -- so a
# consumer's exploratory repetitions must land somewhere a publish step cannot reach.
DEFAULT_OUT = harness.OUT / "modelskill"
DEFAULT_MODEL = harness.DEFAULT_MODEL
# Above this many distinct splits the exact permutation test stops being tractable. It is
# skipped and said so, rather than silently swapped for a sampled one: a second estimator
# appearing under the same column heading is how a table goes quietly wrong.
MAX_SPLITS = 200_000


# ------------------------------------------------------------------ small helpers

def short(model):
    return prof.SHORT.get(model) or model.replace("claude-", "")


def med(rows, key):
    vals = [r[key] for r in rows if r.get(key) is not None]
    return statistics.median(vals) if vals else None


def cv(rows, key):
    vals = [r[key] for r in rows if r.get(key) is not None]
    if len(vals) < 2:
        return None
    m = statistics.fmean(vals)
    return (statistics.pstdev(vals) / m) if m else 0.0


def num(x, spec=",.0f", width=9, dash="-"):
    return f"{dash:>{width}}" if x is None else f"{x:>{width}{spec}}"


def resolve_task(name):
    """Accept a task id or a path, and fail with the available ids rather than a traceback."""
    p = pathlib.Path(name)
    if (p / "prompt.md").exists():
        return p
    for parent in ("tasks", "tasks-retired"):
        cand = ROOT / parent / name
        if (cand / "prompt.md").exists():
            return cand
    ids = sorted(d.name for d in (ROOT / "tasks").iterdir() if (d / "prompt.md").exists())
    sys.exit(f"no such task: {name!r}\navailable: {', '.join(ids)}")


def task_meta(d):
    meta = {}
    if (d / "meta.json").exists():
        meta = json.loads((d / "meta.json").read_text())
    return meta


# ------------------------------------------------------------------ doctor

BLOCK, WARN, OK = "BLOCK", "warn", "ok"


def _port_open(port, host="127.0.0.1"):
    try:
        with socket.create_connection((host, port), 1.5):
            return True
    except OSError:
        return False


def _secret_shape(value):
    """Presence and an 8-hex-char digest -- never the value, never its length by itself.

    Three credential leaks in this project's history came from printing a value someone
    believed was safe, once by way of a neighbouring process's environment. A digest is enough
    to answer the only question worth asking here: is it the token I think it is.
    """
    return "unset" if not value else f"set sha256:{hashlib.sha256(value.encode()).hexdigest()[:8]}"


def apparatus_checks():
    """Is the venv the one the published grid was measured with?

    WARN and not BLOCK, deliberately. A drifted apparatus does not stop you measuring anything;
    it stops your numbers being comparable to the frozen grid, and that is your call to make.
    (`tests/test_apparatus.py` is the strict version of this check, for contributors about to
    add rows to that grid.)
    """
    out, a = [], harness.apparatus()
    pin_file = ROOT / ".python-version"
    pin = pin_file.read_text().strip() if pin_file.exists() else None
    if not pin:
        out.append((WARN, "venv python", f"{a['py_venv']} -- no .python-version to compare"))
    else:
        same = a["py_venv"] == pin
        out.append(((OK if same else WARN), "venv python",
                    f"{a['py_venv']}" + ("" if same else f" but .python-version pins {pin} -- "
                                         f"the venv runs the verdict and sits on the agent's "
                                         f"PATH, so this changes the instrument")))
    lock = ROOT / "requirements.lock"
    if not lock.exists():
        out.append((WARN, "venv packages", f"{len(a['venv_packages'])} installed, no lock file"))
        return out
    want = {m.group(1).lower().replace("_", "-"): m.group(2)
            for m in re.finditer(r"(?m)^([A-Za-z0-9._-]+)==([^\s\\;]+)", lock.read_text())}
    drift = {n: (a["venv_packages"].get(n), v) for n, v in want.items()
             if a["venv_packages"].get(n) != v}
    if drift:
        # Show the libraries we CHOSE before their transitive dependencies. Alphabetical order
        # puts `et-xmlfile` in front of `openpyxl`, which buries the one a reader can act on --
        # requirements.txt is the list of deliberate choices, so it decides precedence.
        declared = {m.group(1).lower().replace("_", "-") for m in
                    re.finditer(r"(?m)^([A-Za-z0-9._-]+)", (ROOT / "requirements.txt").read_text())
                    } if (ROOT / "requirements.txt").exists() else set()
        order = sorted(drift, key=lambda n: (n not in declared, n))
        shown = ", ".join(f"{n} {drift[n][0] or 'MISSING'} != {drift[n][1]}" for n in order[:3])
        out.append((WARN, "venv packages",
                    f"{len(drift)} of {len(want)} differ from requirements.lock ({shown}"
                    + (", ..." if len(drift) > 3 else "")
                    + ") -- a verdict library can move a pass rate on its own"))
    else:
        out.append((OK, "venv packages", f"all {len(want)} match requirements.lock"))
    return out


def doctor_checks():
    out = []                      # (level, name, detail)

    v = sys.version_info
    out.append(((OK if v >= (3, 12) else BLOCK), "python",
                f"{v.major}.{v.minor}.{v.micro} ({sys.executable})"
                + ("" if v >= (3, 12) else "  -- 3.12+ required")))

    claude = shutil.which("claude")
    if not claude:
        out.append((BLOCK, "claude CLI", "not on PATH -- install Claude Code and authenticate"))
    else:
        try:
            ver = subprocess.run([claude, "--version"], capture_output=True, text=True,
                                 timeout=30).stdout.strip()
        except Exception as e:
            ver = f"<version call failed: {type(e).__name__}>"
        out.append((OK, "claude CLI", f"{ver}  ({claude})"))

    # The verdict always runs under the repo venv, whatever interpreter drives the CLI, so
    # openpyxl missing there means every xlsx task fails for a harness reason.
    if not pathlib.Path(harness.VENV_PY).exists():
        out.append((BLOCK, "venv", f"{harness.VENV} missing -- uv venv --python "
                                   f"\"$(cat .python-version)\" && uv pip sync "
                                   f"requirements.lock"))
    else:
        r = subprocess.run([harness.VENV_PY, "-c", "import pytest, openpyxl"],
                           capture_output=True, text=True)
        out.append(((OK if r.returncode == 0 else BLOCK), "venv",
                    f"{harness.VENV} " + ("pytest + openpyxl importable" if r.returncode == 0
                                          else "MISSING deps -- uv pip sync "
                                               "requirements.lock")))
        out.extend(apparatus_checks())

    alive = harness.cortex_alive()
    out.append(((OK if alive else BLOCK), "cortex session api",
                f"{harness.SESSION_API}/healthz "
                + ("200" if alive else "unreachable -- abctl service start")))
    proxy_port = int(harness.CORTEX_PROXY.rsplit(":", 1)[1])
    up = _port_open(proxy_port)
    out.append(((OK if up else BLOCK), "cortex proxy",
                f"{harness.CORTEX_PROXY} " + ("accepting" if up else "closed")))

    ca = pathlib.Path(harness.CORTEX_CA)
    if ca.exists():
        # Hash, not contents. A CA certificate is public, but the habit is the point.
        dg = hashlib.sha256(ca.read_bytes()).hexdigest()[:8]
        out.append((OK, "cortex CA", f"{ca} ({ca.stat().st_size} bytes, sha256:{dg})"))
    else:
        out.append((BLOCK, "cortex CA", f"{ca} missing -- Node needs it via NODE_EXTRA_CA_CERTS"))

    host = harness.TARGET_HOST
    out.append(((OK if host else WARN), "target host",
                host or "ANTHROPIC_BASE_URL unset -- the harness cannot filter Cortex events "
                        "by host, so unrelated traffic in the window would join the row"))

    tok = os.environ.get("ANTHROPIC_AUTH_TOKEN")
    key = os.environ.get("ANTHROPIC_API_KEY")
    out.append(((OK if (tok or key) else WARN), "auth",
                f"ANTHROPIC_AUTH_TOKEN={_secret_shape(tok)}  ANTHROPIC_API_KEY={_secret_shape(key)}"
                + ("" if (tok or key) else "  -- neither set; fine only if `claude` uses a "
                                           "keychain login")))

    np_ = os.environ.get("no_proxy") or os.environ.get("NO_PROXY")
    if not np_:
        out.append((OK, "no_proxy", "unset"))
    else:
        hit = [e.strip() for e in np_.split(",")
               if e.strip() and host and (e.strip().lstrip(".") in host)]
        # lib_child.child_env drops NO_PROXY from the benchmark child (inherit_proxy=False),
        # so this cannot bypass the capture HERE. It is still worth saying: interception is
        # cooperative, and anything else routed through Cortex by hand will skip it.
        out.append((WARN if hit else OK, "no_proxy",
                    f"{np_}"
                    + (f"  -- matches the target host ({hit}). child_env strips it from the "
                       "benchmark child, so runs are unaffected; other processes would bypass "
                       "Cortex silently" if hit else "  (does not match the target host)")))

    skills_root = pathlib.Path(os.path.expanduser("~/.claude/skills"))
    need = set()
    for d in sorted((ROOT / "tasks").iterdir()):
        if not (d / "prompt.md").exists():
            continue
        meta = task_meta(d)
        if meta.get("skill"):
            need.add(meta["skill"])
        need.update(meta.get("candidate_skills") or [])
    missing = sorted(s for s in need if not (skills_root / s).exists())
    out.append(((OK if not missing else BLOCK), "task skills",
                f"{len(need) - len(missing)}/{len(need)} present in {skills_root}"
                + (f" -- MISSING {missing}: the ON arm cannot run" if missing else
                   f" ({', '.join(sorted(need))})")))

    # The ON arm's treatment IS this text, so a drifted skill is a changed experiment, not a
    # changed tool -- but WARN, not BLOCK, the same audience split as the venv pins: a consumer
    # wants a number from whatever they have installed, a contributor is about to add rows to a
    # frozen grid. `skills/MANIFEST.json` is the baseline behind the published profile.
    mpath = ROOT / "skills" / "MANIFEST.json"
    if not mpath.is_file():
        out.append((WARN, "skill digests", f"{mpath.name} absent -- "
                    "run tools/freeze_skills.py to pin what the ON arm is measuring"))
    else:
        frozen = json.loads(mpath.read_text())
        pinned = frozen.get("skills") or {}
        drift = sorted(s for s in need if s in pinned and not missing
                       and harness.skill_tree_sha(skills_root / s) != pinned[s]["tree_sha256"])
        unpinned = sorted(s for s in need if s not in pinned)
        out.append(((OK if not drift and not unpinned else WARN), "skill digests",
                    f"{len(need) - len(drift) - len(unpinned)}/{len(need)} match "
                    f"{mpath.name} (frozen {frozen.get('generated', '?')[:10]})"
                    + (f" -- DRIFTED {drift}: the ON-arm treatment differs from the one behind "
                       f"results/; re-freeze and treat it as a new instrument" if drift else "")
                    + (f" -- UNPINNED {unpinned}" if unpinned else "")))

    lock = harness.OUT / ".harness.lock"
    held = False
    if lock.exists():
        try:
            with lock.open("r") as fh:
                try:
                    fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    fcntl.flock(fh, fcntl.LOCK_UN)
                except BlockingIOError:
                    held = True
        except OSError:
            pass
    out.append(((WARN if held else OK), "run lock",
                "HELD -- another harness run is in progress; runs serialize by design"
                if held else f"free ({lock})"))

    out.append((OK, "sse capture",
                "already running; the harness will adopt it" if harness.sse_alive()
                else "not running; the harness will start and stop its own"))
    return out


def cmd_doctor(a):
    rows = doctor_checks()
    print("autobench-claudecode-cli doctor\n")
    for level, name, detail in rows:
        mark = {OK: "  ok  ", WARN: " warn ", BLOCK: " BLOCK"}[level]
        print(f"[{mark}] {name:19} {detail}")
    blocks = [r for r in rows if r[0] == BLOCK]
    warns = [r for r in rows if r[0] == WARN]
    print(f"\n{len(rows) - len(blocks) - len(warns)} ok, {len(warns)} warning(s), "
          f"{len(blocks)} blocker(s)")
    if blocks:
        print("\nBlocked. Each blocker below makes a repetition unmeasurable rather than")
        print("merely awkward -- with Cortex down every token field is 0 and the row")
        print("self-flags no_cortex_inference_events.")
        return 1
    return 0


# ------------------------------------------------------------------ tasks / models

def cmd_tasks(a):
    root = ROOT / ("tasks-retired" if a.retired else "tasks")
    last = "why it was discarded" if a.retired else "workspace"
    print(f"{'task':26} {'mode':10} {'skill':8} {'verdict':8} {'arms':16} {last}")
    for d in sorted(root.iterdir()):
        if not (d / "prompt.md").exists():
            continue
        meta = task_meta(d)
        mode = meta.get("mode") or "compliance"
        skill = meta.get("skill") or "-"
        if (d / "verdict").exists():
            vd = "hidden"
        elif list((d / "workspace").glob("test_*.py")):
            vd = "visible"
        else:
            vd = "none"
        arms = "select" if mode == "selection" else ("on,off" if meta.get("skill") else "on")
        if a.retired:
            # The verdict on the task, not on the model -- "a discarded task is a result", so
            # the reason belongs in the listing rather than one file-open away.
            dm = d / "DISCARDED.md"
            head = dm.read_text().split("\n\n")[0].replace("\n", " ") if dm.exists() else ""
            tail = head[:76] or "<no DISCARDED.md>"
        else:
            tail = ", ".join(sorted(p.name for p in (d / "workspace").iterdir()
                                   if p.is_file())) or "-"
        print(f"{d.name:26} {mode:10} {skill:8} {vd:8} {arms:16} {tail}")
    print("\nverdict: hidden = installed after the agent exits (compliance; the test is the")
    print("answer key) · visible = the tests ARE the spec · none = scored from the transcript.")
    if not a.retired:
        print("Retired tasks (each with the reason it was discarded): --retired")
    return 0


def cmd_models(a):
    print(f"{'alias':28} {'gateway entry':24} {'in $/1M':>8} {'out $/1M':>9} {'out:in':>7}")
    for m, ui, i, o, r in pricing.table():
        print(f"{m:28} {ui:24} {i:>8.2f} {o:>9.2f} {r:>6.1f}x")
    print(f"\nrate card : {pricing.SOURCE}")
    print(f"dated     : {pricing.SOURCE_DATE} -- hand-maintained; edit pricing.PRICES and bump")
    print(f"            SOURCE_DATE when rates change")
    print(f"cache      : scenario B bills cacheRead x{pricing.CACHE_READ_MULT}, "
          f"cacheWrite x{pricing.CACHE_WRITE_MULT}; scenario A bills every prompt token at")
    print( "            the input rate. Which one the gateway applies is UNVERIFIED and matters:")
    print( "            cache reads are 81-97% of prompt tokens, so A lands ~4-5x above B.")
    print( "\nAny --model string is accepted; a model absent from the card above simply reports")
    print( "no cost column. Volume and latency still work.")
    return 0


# ------------------------------------------------------------------ invoking

def invoke(task_dir, arm, model, reps, out_dir, dry_run=False, skill_variant=None):
    cmd = [sys.executable, "-u", str(ROOT / "harness.py"), str(task_dir),
           "--reps", str(reps), "--arm", arm, "--model", model, "--out", str(out_dir)]
    if skill_variant:
        cmd += ["--skill-variant", skill_variant]
    if dry_run:
        print("   would run: " + " ".join(shlex.quote(c) for c in cmd))
        return 0
    # The child writes to this same stdout. Flush first or our own buffered plan appears AFTER
    # the run it describes whenever the output is piped rather than on a terminal.
    sys.stdout.flush()
    # Not captured: the harness prints a line per repetition and a multi-hour grid with no
    # output is indistinguishable from a hung one.
    return subprocess.run(cmd).returncode


def plan_note(n_cells, reps, out_dir):
    print(f"cells    : {n_cells}")
    print(f"reps     : {reps} per cell  ->  {n_cells * reps} `claude -p` invocation(s), "
          f"each real and billable")
    print(f"out      : {out_dir}  (outside profile.RUN_DIRS, so `--freeze` cannot reach it)")
    if reps < 3:
        print("WARNING  : fewer than 3 repetitions. This subject is not deterministic -- a "
              "single\n           repetition is an anecdote, and the report prints medians.")


def cmd_run(a):
    task_dir = resolve_task(a.task)
    out_dir = pathlib.Path(a.out)
    plan_note(1, a.reps, out_dir)
    if a.skill_variant:
        print(f"variant  : {a.skill_variant}  (skills/<skill>-{a.skill_variant}/overlay.json "
              f"applied to the installed skill; rows record skill_variant + skill_sha)")
    print()
    return invoke(task_dir, a.arm, a.model, a.reps, out_dir, a.dry_run,
                  skill_variant=a.skill_variant)


def cmd_screen(a):
    """The gate. A task the agent passes WITHOUT the skill is not measuring the skill.

    Delegates to sweep.py, which already prints the DISCARD/keep verdict -- 9 of the first 11
    tasks written died here, so this is the first command to run against a new task, not a
    formality afterwards.
    """
    cmd = [sys.executable, "-u", str(ROOT / "sweep.py"), "--arm", a.arm,
           "--reps", str(a.reps), "--pattern", a.pattern, "--model", a.model,
           "--out", str(a.out)]
    if a.skill_variant:
        cmd += ["--skill-variant", a.skill_variant]
    if a.dry_run:
        print("would run: " + " ".join(shlex.quote(c) for c in cmd))
        return 0
    sys.stdout.flush()
    return subprocess.run(cmd).returncode


def cmd_compare(a):
    task_dirs = [resolve_task(t) for t in a.task]
    models = [m.strip() for m in a.models.split(",") if m.strip()]
    arms = [x.strip() for x in a.arms.split(",") if x.strip()]
    out_dir = pathlib.Path(a.out)
    cells = [(t, arm, m) for t in task_dirs for arm in arms for m in models]

    print("autobench-claudecode-cli compare\n")
    print(f"tasks    : {', '.join(t.name for t in task_dirs)}")
    print(f"arms     : {', '.join(arms)}")
    print(f"models   : {', '.join(models)}")
    plan_note(len(cells), a.reps, out_dir)
    unpriced = [m for m in models if m not in pricing.PRICES]
    if unpriced:
        print(f"note     : no rate card entry for {unpriced} -- volume and latency will be "
              f"reported, cost will not")
    print()

    failed = []
    for i, (t, arm, m) in enumerate(cells, 1):
        print(f"[{i}/{len(cells)}] {t.name} arm={arm} model={m}", flush=True)
        if invoke(t, arm, m, a.reps, out_dir, a.dry_run) != 0:
            failed.append((t.name, arm, m))
            print(f"   !! harness exited non-zero for {t.name}/{arm}/{m}", flush=True)
    if a.dry_run:
        return 0
    if failed:
        print(f"\n{len(failed)} cell(s) failed to run: {failed}")
    print()
    return report(out_dir, tasks=[t.name for t in task_dirs], arms=arms, models=models,
                  scenario=a.scenario, significance=a.significance, as_json=False)


# ------------------------------------------------------------------ report

def load_rows(out_dir, tasks=None, arms=None, models=None):
    """Every repetition under out_dir, keyed (task, arm, model) -- the same key profile.load
    uses, so tools/cost_significance.py's comparisons accept this mapping unchanged.

    Membership is the directory, not a manifest, and the report says so out loud. The pinned
    alternative exists for the PUBLISHED grid (`profile.py --freeze`) because a published
    number whose inputs are "whatever is on disk today" is not reproducible, merely
    undisturbed. A consumer's own exploration does not need that ceremony -- but it does need
    to know which files it just read, so every file is listed with its digest.
    """
    files = sorted(glob.glob(str(pathlib.Path(out_dir) / "*.ndjson")))
    by, membership, total = defaultdict(list), [], 0
    for f in files:
        p = pathlib.Path(f)
        rows = [json.loads(ln) for ln in p.read_text().splitlines() if ln.strip()]
        if not rows:
            continue
        kept = 0
        for r in rows:
            # In-memory only, never written back: rep numbers restart at 1 in every file, so
            # without this two repetitions from two runs of the same cell print identically.
            r["_src"] = p.name
            key = (r["task_id"], r.get("arm", "on"),
                   r.get("model_requested") or "<unpinned>")
            if tasks and key[0] not in tasks:
                continue
            if arms and key[1] not in arms:
                continue
            if models and key[2] not in models:
                continue
            by[key].append(r)
            kept += 1
        if kept:
            # Only contributing files are listed, and the digest covers the WHOLE file even
            # when a filter took part of it -- a provenance line that named files the numbers
            # do not come from would be worse than none.
            membership.append((p.name, kept, len(rows),
                               hashlib.sha256(p.read_bytes()).hexdigest()[:12]))
            total += kept
    return by, membership, total


def rep_costs(rows, model, scenario):
    if model not in pricing.PRICES:
        return []
    return [cs.rep_cost(r, model, scenario) for r in rows]


def cell_metrics(rows, model, scenario):
    """One cell. `None` anywhere means not measured -- never substituted with a zero."""
    clean = cs.clean(rows)      # confounded repetitions are VOID, never averaged in
    if not clean:
        return None
    calls = med(clean, "llm_calls")
    tok = med(clean, "total_tokens")
    rate = sum(1 for r in clean if r["passed"]) / len(clean)
    costs = rep_costs(clean, model, scenario)
    # Published estimator: per-column medians THEN priced. Kept because it is what every
    # figure in results/EVALUATION.md uses; the median of a sum is not the sum of the
    # medians, so the per-rep median beside it legitimately differs.
    cost_m1 = cs.method1(clean, model, scenario) if model in pricing.PRICES else None
    timed = [r for r in clean if r.get("cli_duration_api_ms") is not None]
    return dict(
        n=len(clean), dropped=len(rows) - len(clean), passed=rate,
        tok=tok, tok_cv=cv(clean, "total_tokens"), calls=calls,
        tpc=(tok / calls) if (tok and calls) else None,
        tools=med(clean, "tool_calls"),
        uncached=med(clean, "input_tokens"), cache_r=med(clean, "cache_read_tokens"),
        cache_w=med(clean, "cache_write_tokens"), out=med(clean, "completion_tokens"),
        prompt=med(clean, "prompt_tokens"),
        cost=cost_m1,
        cost_rep=statistics.median(costs) if costs else None,
        cost_cv=(statistics.pstdev(costs) / statistics.fmean(costs))
                if len(costs) > 1 and statistics.fmean(costs) else None,
        api_ms=med(clean, "cli_duration_api_ms"), api_cv=cv(clean, "cli_duration_api_ms"),
        ttft_ms=med(clean, "cli_ttft_ms"),
        wall=med(clean, "wall_seconds"), wall_cv=cv(clean, "wall_seconds"),
        timed=len(timed), rows=clean)


def per_solved(value, rate):
    return (value / rate) if (value is not None and rate) else None


def cold_reps(rows):
    """Repetitions in ONE CELL whose cacheWrite share is an outlier -- a cold cache.

    A first repetition in a fresh session re-tiers roughly 29k prompt tokens from cacheRead
    (x0.10) to cacheWrite (x1.25) at an unchanged TOTAL. That is a 12.5x price ratio on those
    tokens and it moved a three-repetition mean by ~30%, which was read as a model difference
    for a day. The detector is the tier split against a median -- not cost, and not CV. Both
    the share function and the threshold are imported from tools/stability_probe.py rather
    than restated, so "cold" means here exactly what it meant in the study.

    The baseline is the CELL'S OWN median, not the whole report's. Cache behaviour differs
    between models for honest reasons -- haiku's steady-state cacheWrite share is around 14%
    where sonnet's is 5% -- so a pooled baseline flags an entire model as permanently cold and
    says nothing about any repetition.
    """
    if len(rows) < 3:
        # A median over one or two repetitions is those repetitions; a cold first rep would
        # become its own baseline and hide.
        return [], None
    base = statistics.median(sp.cw_share(r) for r in rows)
    return [r for r in rows if sp.cw_share(r) > sp.COLD_MULT * base], base


def report(out_dir, tasks=None, arms=None, models=None, scenario="B", significance=False,
           as_json=False):
    by, membership, total = load_rows(out_dir, tasks, arms, models)
    if not by:
        print(f"no repetitions found in {out_dir}")
        print("run some first:  autobench-claudecode-cli compare --task xlsx-fin-colors "
              "--models claude-sonnet-5,claude-opus-5")
        return 1

    keys = sorted(by)
    cells = {}
    for key in keys:
        m = cell_metrics(by[key], key[2], scenario)
        if not m:
            continue
        bad = prof.integrity(m["rows"])
        if bad:
            # The two token identities must hold; a cell failing them is not reportable.
            print(f"  QUARANTINED {'/'.join(key)}: {bad}")
            continue
        cells[key] = m

    if not cells:
        # Rows were found and every one of them was unreportable. Printing empty tables and
        # exiting 0 would read as "nothing to see here" rather than "the data is broken".
        print(f"{total} repetition(s) read from {out_dir}, none reportable -- see the "
              f"quarantine lines above")
        return 1

    if as_json:
        print(json.dumps({
            "out_dir": str(out_dir), "scenario": scenario,
            "membership": [{"file": f, "rows_used": n, "rows_in_file": nf, "sha256": d}
                           for f, n, nf, d in membership],
            "cells": [{"task": k[0], "arm": k[1], "model": k[2],
                       **{kk: vv for kk, vv in v.items() if kk != "rows"}}
                      for k, v in cells.items()]}, indent=2, default=str))
        return 0

    print("=" * 108)
    print("MODEL x SKILL BENCHMARK".center(108))
    print("=" * 108)
    print(f"out dir    : {out_dir}")
    print(f"membership : {len(membership)} file(s), {total} repetition(s) -- UNPINNED: whatever "
          f"is on disk now, not a frozen manifest")
    for f, n, n_file, d in membership:
        of = "" if n == n_file else f" of {n_file}"
        print(f"   {f}  {n}{of} row(s)  sha256:{d}")

    # ---- volume: the measures that decide whether a cell reproduced -------------
    print("\n" + "-" * 108)
    print("VOLUME -- workload measures. These, and only these, decide whether a cell "
          "reproduced.\n")
    print(f"{'task':22} {'arm':4} {'model':12} {'n':>2} {'drop':>4} {'pass':>5} "
          f"{'tokens':>9} {'CV':>5} {'calls':>5} {'tok/call':>8} {'tools':>5} "
          f"{'uncached':>8} {'cacheR':>9} {'cacheW':>7} {'out':>6}")
    for k in keys:
        c = cells.get(k)
        if not c:
            continue
        print(f"{k[0]:22} {k[1]:4} {short(k[2]):12} {c['n']:>2} {c['dropped']:>4} "
              f"{c['passed']:>5.2f} {num(c['tok'])} {num(c['tok_cv'], '.2f', 5)} "
              f"{num(c['calls'], '.0f', 5)} {num(c['tpc'], ',.0f', 8)} "
              f"{num(c['tools'], '.0f', 5)} {num(c['uncached'], ',.0f', 8)} "
              f"{num(c['cache_r'], ',.0f', 9)} {num(c['cache_w'], ',.0f', 7)} "
              f"{num(c['out'], ',.0f', 6)}")
    print("\ntokens per task = tok/call x calls. Split them: tok/call is a model near-constant")
    print("(+-5% across five structurally different cells), calls is a property of the WORK")
    print("(0.4-2.0x for one model). A total hides which term moved.")

    # ---- cost ------------------------------------------------------------------
    priced = [k for k in keys if k in cells and k[2] in pricing.PRICES]
    print("\n" + "-" * 108)
    mult = (f"cacheRead x{pricing.CACHE_READ_MULT}, cacheWrite x{pricing.CACHE_WRITE_MULT}"
            if scenario == "B" else "every prompt token at the input rate (upper bound)")
    print(f"COST -- scenario {scenario}: {mult}. Rate card dated {pricing.SOURCE_DATE}.\n")
    if not priced:
        print("  no cell has a rate card entry; `autobench-claudecode-cli models` lists what is "
              "priced")
    else:
        print(f"{'task':22} {'arm':4} {'model':12} {'n':>2} {'pass':>5} {'$/task':>9} "
              f"{'$/rep med':>10} {'CV':>5} {'$/solved':>10} {'tok/solved':>11}")
        for k in priced:
            c = cells[k]
            ps = per_solved(c["cost"], c["passed"])
            ts = per_solved(c["tok"], c["passed"])
            zero = c["passed"] == 0
            print(f"{k[0]:22} {k[1]:4} {short(k[2]):12} {c['n']:>2} {c['passed']:>5.2f} "
                  f"{num(c['cost'], '.4f', 9)} {num(c['cost_rep'], '.4f', 10)} "
                  f"{num(c['cost_cv'], '.2f', 5)} "
                  + (f"{'undefined':>10} {'undefined':>11}" if zero
                     else f"{num(ps, '.4f', 10)} {num(ts, ',.0f', 11)}"))
        print("\n$/task is the PUBLISHED estimator: per-column medians, then priced. $/rep med")
        print("prices each repetition first -- the median of a sum is not the sum of the")
        print("medians, so the two legitimately differ. Both divide by pass rate in the")
        print("/solved columns, which charges a model for its failures.")
        print("\nRead the last two columns as SEPARATE questions. Unit price spans 5x across")
        print("these models and token counts only ~2x, so the two rankings can invert exactly:")
        print("on cortex-pyfix-001 opus-5 is 1st on tokens/solved and 4th on $/solved. Whichever")
        print("one binds -- a context window, or the bill -- name it.")

    # ---- latency ---------------------------------------------------------------
    print("\n" + "-" * 108)
    print("LATENCY -- api is the model's own time (excludes local tool execution). "
          "wall is a DIAGNOSTIC.\n")
    print(f"{'task':22} {'arm':4} {'model':12} {'n':>2} {'api_s':>7} {'CV':>5} "
          f"{'ttft_s':>7} {'api_s/call':>10} {'wall_s':>7} {'CV':>5} {'timed':>6}")
    untimed = 0
    for k in keys:
        c = cells.get(k)
        if not c:
            continue
        untimed += c["n"] - c["timed"]
        api_s = (c["api_ms"] / 1000) if c["api_ms"] is not None else None
        ttft_s = (c["ttft_ms"] / 1000) if c["ttft_ms"] is not None else None
        per_call = (api_s / c["calls"]) if (api_s and c["calls"]) else None
        print(f"{k[0]:22} {k[1]:4} {short(k[2]):12} {c['n']:>2} {num(api_s, '.1f', 7)} "
              f"{num(c['api_cv'], '.2f', 5)} {num(ttft_s, '.1f', 7)} "
              f"{num(per_call, '.1f', 10)} {num(c['wall'], '.1f', 7)} "
              f"{num(c['wall_cv'], '.2f', 5)} {c['timed']}/{c['n']}")
    if untimed:
        print(f"\n{untimed} repetition(s) carry no api timing -- they predate the CLI result")
        print("event being persisted. Re-run them to measure latency; the dash is a missing")
        print("measurement, not a zero.")
    print("\nWall time follows machine load: it moved x1.34-1.81 for two models doing provably")
    print("identical work. Never conclude anything about a model from the wall column.")

    # ---- skill effect ----------------------------------------------------------
    pairs = [(t, m) for (t, arm, m) in cells if arm == "on"
             and (t, "off", m) in cells]
    if pairs:
        print("\n" + "-" * 108)
        print("SKILL EFFECT -- ON / OFF, same task, same model. The ratio is what the skill "
              "costs.\n")
        print(f"{'task':22} {'model':12} {'tokens':>8} {'calls':>8} {'$':>8} {'api':>8} "
              f"  pass rate")
        for t, m in sorted(set(pairs)):
            on, off = cells[(t, "on", m)], cells[(t, "off", m)]

            def ratio(key, width=8):
                a, b = on.get(key), off.get(key)
                return f"{'-':>{width}}" if not (a and b) else f"{a / b:>{width - 1}.2f}x"

            print(f"{t:22} {short(m):12} {ratio('tok')} {ratio('calls')} {ratio('cost')} "
                  f"{ratio('api_ms')}   {off['passed']:.2f} -> {on['passed']:.2f}")
        print("\nThe arms are NOT token-comparable by construction -- the ON arm carries the")
        print("injected SKILL.md (~2.9k tokens, a near-constant +3.3-3.4k per LLM call). Pass")
        print("rate is the primary measure; the ratios say what that verdict change cost.")

    # ---- cold-cache repetitions ------------------------------------------------
    flagged = []
    for k in keys:
        if k not in cells:
            continue
        cold, base = cold_reps(cells[k]["rows"])
        flagged += [(k, r, base) for r in cold]
    if flagged:
        print("\n" + "-" * 108)
        print("COLD-CACHE REPETITIONS -- named, not dropped. Baseline is each cell's own "
              "median.\n")
        for k, r, base in flagged:
            print(f"  {k[0]}/{k[1]}/{short(k[2])} rep {r['rep']} ({r['_src']}): "
                  f"cacheWrite {sp.cw_share(r):.0%} of prompt vs {base:.0%} in its cell")
        print("\nThese re-tier prompt tokens from cacheRead (x0.10) to cacheWrite (x1.25) at an")
        print("UNCHANGED total, so they inflate cost while volume is untouched. Judge")
        print("reproduction on volume; if a cost gap rests on one of these, it is not a finding.")

    # ---- ranking ---------------------------------------------------------------
    print("\n" + "-" * 108)
    print("RANKING, per task and arm -- best model by each measure\n")
    for t, arm in sorted({(k[0], k[1]) for k in cells}):
        group = {k[2]: cells[k] for k in cells if k[0] == t and k[1] == arm}
        if len(group) < 2:
            continue

        def best(fn):
            scored = [(fn(c), m) for m, c in group.items() if fn(c) is not None]
            return min(scored)[1] if scored else None

        b_tok = best(lambda c: per_solved(c["tok"], c["passed"]))
        b_cost = best(lambda c: per_solved(c["cost"], c["passed"]))
        b_api = best(lambda c: c["api_ms"])
        b_pass = max(group.items(), key=lambda kv: kv[1]["passed"])[0]
        print(f"  {t}/{arm:4} pass={short(b_pass)}  tokens/solved={short(b_tok) if b_tok else '-'}"
              f"  $/solved={short(b_cost) if b_cost else '-'}"
              f"  latency={short(b_api) if b_api else '-'}")
    print("\nA point estimate is not a finding. Per-repetition cost CV runs 0.05-0.42 here, so")
    print("a median gap of a few percent is noise at these sample sizes. Pass --significance.")

    if significance:
        report_significance(by, cells, scenario)

    print("\n" + "=" * 108)
    ns = sorted({c["n"] for c in cells.values()})
    print(f"n per cell : {ns[0] if len(ns) == 1 else f'{ns[0]}-{ns[-1]} -- UNEVEN, read the n column'}")
    print(f"dropped    : {sum(c['dropped'] for c in cells.values())} confounded repetition(s) "
          f"excluded from every number above")
    print("Confounded repetitions are VOID, not failed -- a subagent spawn, a leaked skill, a")
    print("model substituted on the wire. They are recorded in the NDJSON and never averaged in.")
    return 0


def report_significance(by, cells, scenario):
    """Exact permutation tests between models, per cell. Reuses tools/cost_significance.py.

    Same code path as the published significance table, so a consumer's answer is computed the
    way the study's was. The two things to read are the FLOOR -- the smallest p this design can
    produce, which at 5 v 5 is 2/252 = 0.008 -- and the reps-for-80% column, which assumes the
    cell is STATIONARY across sessions. That assumption was bought and falsified once on
    xlsx-fin-font-clean: the ~8 reps it prescribed were purchased and the gap changed sign.
    """
    print("\n" + "-" * 108)
    print(f"SIGNIFICANCE -- exact two-sided permutation test on per-repetition scenario-"
          f"{scenario} cost\n")
    print(f"  {'cell':28} {'a':11} {'b':11} {'n':>7} {'gap':>7} {'d':>6} {'p':>7} "
          f"{'floor':>7} {'80%':>6}  verdict")
    any_row = False
    for t, arm in sorted({(k[0], k[1]) for k in cells}):
        ms = sorted(k[2] for k in cells if k[0] == t and k[1] == arm
                    and k[2] in pricing.PRICES)
        for i, m1 in enumerate(ms):
            for m2 in ms[i + 1:]:
                na = len([r for r in by[(t, arm, m1)] if not r["confounded"]])
                nb = len([r for r in by[(t, arm, m2)] if not r["confounded"]])
                if min(na, nb) < 2:
                    continue
                splits = math.comb(na + nb, na)
                if splits > MAX_SPLITS:
                    print(f"  {t + '/' + arm:28} {short(m1):11} {short(m2):11} "
                          f"{f'{na}v{nb}':>7}  exact test skipped: C({na + nb},{na})="
                          f"{splits:,} splits > {MAX_SPLITS:,}")
                    any_row = True
                    continue
                r = cs.compare(by, t, arm, m1, m2, scenario)
                if not r:
                    continue
                any_row = True
                print(f"  {t + '/' + arm:28} {short(m1):11} {short(m2):11} "
                      f"{f'{na}v{nb}':>7} {r['saving']:>6.1%} {r['d']:>6.2f} {r['p']:>7.3f} "
                      f"{r['floor']:>7.3f} {r['need']:>6}  {cs.verdict(r, min(na, nb))}")
    if not any_row:
        print("  nothing comparable: a test needs two priced models with >=2 clean "
              "repetitions in the same cell")
        return
    print("\ngap = how much cheaper `a` is than `b` on per-repetition MEAN cost; negative means")
    print("dearer. It is not the $/task gap in the cost table above, which compares the")
    print("per-column-median estimator -- a median token profile priced is not the mean of")
    print("priced repetitions, and the two have differed by 7 points in this study.")
    print("floor = the smallest two-sided p this design can produce (2/splits for equal group")
    print("sizes, 1/splits otherwise). A p equal to the floor means the groups separate")
    print("completely at the design's limit -- it is not a large-sample result.")
    print("80% assumes the cell is STATIONARY across sessions. On xlsx-fin-font-clean that")
    print("assumption was bought and falsified: the reps it prescribed were purchased and the")
    print("gap changed sign. Re-measure a cell before trusting its prescription.")


def cmd_report(a):
    return report(pathlib.Path(a.out),
                  tasks=a.task or None, arms=(a.arms.split(",") if a.arms else None),
                  models=([m.strip() for m in a.models.split(",")] if a.models else None),
                  scenario=a.scenario, significance=a.significance, as_json=a.json)


# ------------------------------------------------------------------ argv

def build_parser():
    ap = argparse.ArgumentParser(
        prog="autobench-claudecode-cli",
        description="Benchmark a Claude Code skill across models: token efficiency, cost "
                    "efficiency, latency.",
        epilog="Measured through Cortex. Start with `autobench-claudecode-cli doctor`.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add_out(p, default=DEFAULT_OUT):
        p.add_argument("--out", default=str(default),
                       help=f"NDJSON output directory (default {default}). Kept outside "
                            f"profile.RUN_DIRS so a later --freeze cannot publish it.")

    p = sub.add_parser("doctor", help="check every prerequisite; exit 1 on a blocker")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("tasks", help="list benchmark tasks")
    p.add_argument("--retired", action="store_true",
                   help="list discarded tasks instead (each has a DISCARDED.md; a discarded "
                        "task is a result)")
    p.set_defaults(fn=cmd_tasks)

    p = sub.add_parser("models", help="model aliases and the rate card behind the cost column")
    p.set_defaults(fn=cmd_models)

    p = sub.add_parser("screen", help="OFF-arm gate: is the task measuring the skill?")
    p.add_argument("--pattern", default="xlsx-*", help="task glob under tasks/ (default xlsx-*)")
    p.add_argument("--arm", choices=["off", "on", "select"], default="off",
                   help="default off -- the gate. A task that passes without the skill is "
                        "not measuring the skill and must be discarded")
    p.add_argument("--reps", type=int, default=3)
    p.add_argument("--model", default=DEFAULT_MODEL)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--skill-variant", default=None, metavar="NAME",
                   help="apply the edit recipe skills/<skill>-NAME/overlay.json to the "
                        "installed skill instead of using it verbatim -- ON arm only. "
                        "This measures an edit to the SKILL, so it is a different "
                        "experiment, not a different setting (see skills/README.md)")
    add_out(p)
    p.set_defaults(fn=cmd_screen)

    p = sub.add_parser("run", help="one cell: task x arm x model x reps")
    p.add_argument("--task", required=True, help="task id or path")
    p.add_argument("--arm", choices=["on", "off", "select"], default="on")
    p.add_argument("--model", default=DEFAULT_MODEL)
    p.add_argument("--reps", type=int, default=5)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--skill-variant", default=None, metavar="NAME",
                   help="apply the edit recipe skills/<skill>-NAME/overlay.json to the "
                        "installed skill instead of using it verbatim -- ON arm only. "
                        "This measures an edit to the SKILL, so it is a different "
                        "experiment, not a different setting (see skills/README.md)")
    add_out(p)
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("compare", help="one task set across several models, then report")
    p.add_argument("--task", action="append", required=True,
                   help="task id or path; repeatable")
    p.add_argument("--models", required=True, help="comma-separated model aliases")
    p.add_argument("--arms", default="on,off",
                   help="comma-separated arms (default on,off -- the control is what makes "
                        "the ON arm mean anything)")
    p.add_argument("--reps", type=int, default=5)
    p.add_argument("--scenario", choices=["A", "B"], default="B")
    p.add_argument("--significance", action="store_true",
                   help="exact permutation tests between models after the run")
    p.add_argument("--dry-run", action="store_true")
    add_out(p)
    p.set_defaults(fn=cmd_compare)

    p = sub.add_parser("report", help="compile token/cost/latency from stored runs; no invocations")
    p.add_argument("--task", action="append", help="filter by task id; repeatable")
    p.add_argument("--arms", help="comma-separated arms to include")
    p.add_argument("--models", help="comma-separated models to include")
    p.add_argument("--scenario", choices=["A", "B"], default="B",
                   help="B = standard cache discounts (likely); A = every prompt token at the "
                        "input rate (upper bound). Which the gateway applies is unverified")
    p.add_argument("--significance", action="store_true",
                   help="exact permutation tests between models in each cell")
    p.add_argument("--json", action="store_true", help="machine-readable metrics")
    add_out(p)
    p.set_defaults(fn=cmd_report)
    return ap


def main(argv=None):
    a = build_parser().parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
